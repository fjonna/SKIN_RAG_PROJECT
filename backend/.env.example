# Copy this file to .env (in the same backend/ folder) and fill in your key.
# .env is already git-ignored, so it will never be committed.

# Required for LLM-generated explanations in /diagnose-multimodal.
# Get a key at https://console.anthropic.com/settings/keys
# Without this, the system falls back to a deterministic summary automatically.
ANTHROPIC_API_KEY=

# Optional: override the default generation model.
# GENERATION_MODEL=claude-sonnet-5
